# Analytics Service
PORT=8003
POSTGRES_URL=postgresql://atlas_user:atlas_password@postgres:5432/atlas_db
OPENAI_API_KEY=

# Heavy endpoint concurrency limits (see main.py).
# ANALYTICS_HEAVY_MAX_CONCURRENCY is a global cost budget shared by the heavy
# endpoints; a payroll sweep costs 2 units and an AI insight call costs 3.
# ANALYTICS_HEAVY_MAX_PER_TENANT caps one tenant's concurrent heavy requests.
# Over-limit requests wait in a queue of ANALYTICS_HEAVY_QUEUE_LIMIT for at
# most ANALYTICS_HEAVY_QUEUE_WAIT_SECONDS, then get 503 + Retry-After
# (ANALYTICS_HEAVY_RETRY_AFTER_SECONDS).
ANALYTICS_HEAVY_MAX_CONCURRENCY=8
ANALYTICS_HEAVY_MAX_PER_TENANT=2
ANALYTICS_HEAVY_QUEUE_LIMIT=32
ANALYTICS_HEAVY_QUEUE_WAIT_SECONDS=5
ANALYTICS_HEAVY_RETRY_AFTER_SECONDS=2

# #478: bounded pool + statement timeout for the analytics engine
# (docs/db-pool-policy.md). Pool saturation answers 503 with
# atlas_db_pool_exhausted_total instead of queueing silently.
ANALYTICS_DATABASE_STATEMENT_TIMEOUT_MS=15000
ANALYTICS_DATABASE_POOL_SIZE=5
ANALYTICS_DATABASE_MAX_OVERFLOW=10
