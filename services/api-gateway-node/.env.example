# API Gateway
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://redis:6379

# Backend service URLs
AUTH_SERVICE_URL=http://auth-service:8010
EMPLOYEE_SERVICE_URL=http://employee-service:8001
PAYROLL_SERVICE_URL=http://payroll-service:8002
ANALYTICS_SERVICE_URL=http://analytics-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
ATTENDANCE_SERVICE_URL=http://attendance-service:8005
LEAVE_SERVICE_URL=http://leave-service:8006
ATS_SERVICE_URL=http://ats-service:8012
LMS_SERVICE_URL=http://lms-service:8013
PERFORMANCE_SERVICE_URL=http://performance-service:8014
AI_COPILOT_SERVICE_URL=http://ai-copilot-service:8015
AUDIT_COMPLIANCE_SERVICE_URL=http://audit-compliance-service:8011

# Audit Service Integration (x-internal-auth JWT with audit-writer audience)
# Authenticated with INTERNAL_JWT_SECRET, no separate audit key.
INTERNAL_JWT_SECRET=

# Slack Webhook Verification (issue #133)
SLACK_SIGNING_SECRET=change-me-to-slack-signing-secret
# Optional extra bot token for /atlas slash commands and interactive approvals
# (identity resolution needs Slack users.info email scopes).
SLACK_BOT_TOKEN=
# Optional per-workspace signing secrets for /atlas commands and interactive
# components, keyed by Slack team_id. A workspace without an entry (and without
# SLACK_SIGNING_SECRET) keeps the commands route off (fail closed).
SLACK_TENANT_SIGNING_SECRETS=
SLACK_WEBHOOK_SECRET=change-me-to-long-random-secret

# Live and Workforce services (issue #155)
LIVE_SERVICE_URL=http://live-service:8060
WORKFORCE_SERVICE_URL=http://workforce-planning-service:8017
