# Employee Service
PORT=8001
MONGO_URL=mongodb://admin:admin_password@mongodb:27017/atlas_db?authSource=admin
RABBITMQ_URL=amqp://atlas_rabbit:changeme_rabbit_pass@rabbitmq:5672/
INTERNAL_JWT_SECRET=atlas-internal-jwt-secret-change-me

# Shared read cache (atlas_observability.read_cache) for the /employees
# directory list. Backed by Redis when REDIS_URL is set; without it the
# helper degrades to a small in-process store. Every write endpoint
# invalidates the tenant's entries, so a write is reflected on the next
# read. Auth and permission decisions (single lookups, hierarchy scoping)
# are never cached.
REDIS_URL=redis://redis:6379
EMPLOYEE_DIRECTORY_CACHE_TTL=30
